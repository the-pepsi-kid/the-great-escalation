{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Great Escalation card catalog v0.1",
  "type": "object",
  "required": [
    "title",
    "version",
    "edition",
    "tagline",
    "categories",
    "cards"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "const": "THE GREAT ESCALATION"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "edition": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "count",
          "color"
        ],
        "properties": {
          "code": {
            "enum": [
              "M",
              "D",
              "P",
              "C",
              "H",
              "W"
            ]
          },
          "name": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "color": {
            "type": "string"
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 110,
      "maxItems": 110,
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "category_code",
        "color",
        "type",
        "cost",
        "timing",
        "target",
        "condition",
        "effects",
        "rules",
        "rules_short",
        "restriction",
        "counterplay",
        "flavor",
        "illustration",
        "balance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TGE-[MDPCHW][0-9]{2}$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "category": {
          "type": "string"
        },
        "category_code": {
          "enum": [
            "M",
            "D",
            "P",
            "C",
            "H",
            "W"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "type": {
          "enum": [
            "Action",
            "Support",
            "Incident"
          ]
        },
        "cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "timing": {
          "type": "string"
        },
        "target": {
          "enum": [
            "none",
            "real",
            "unknown",
            "rumor",
            "rival"
          ]
        },
        "condition": {
          "enum": [
            null,
            "verified",
            "network",
            "emergency",
            "fundEmergency",
            "panic",
            "liability",
            "ownRumor",
            "counterDiscard"
          ]
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "op",
              "n"
            ],
            "properties": {
              "op": {
                "enum": [
                  "influence",
                  "credibility",
                  "panic",
                  "stability",
                  "draw",
                  "reach",
                  "leverage",
                  "liability",
                  "shield",
                  "boost",
                  "report",
                  "repair",
                  "verify",
                  "rumor",
                  "escalate",
                  "contain",
                  "containAll",
                  "audit",
                  "auditAll",
                  "steal",
                  "transfer",
                  "clearLiability",
                  "withdraw",
                  "debunkAll",
                  "verifyAll",
                  "allIncome",
                  "clearBoosts",
                  "action",
                  "reclaim",
                  "install",
                  "incident"
                ]
              },
              "n": {
                "type": "integer"
              },
              "asset": {
                "enum": [
                  "engineer",
                  "field",
                  "runbook"
                ]
              },
              "panic": {
                "type": "integer"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cause": {
                "type": "string"
              }
            }
          }
        },
        "rules": {
          "type": "string",
          "minLength": 10
        },
        "rules_short": {
          "type": "string",
          "minLength": 10
        },
        "restriction": {
          "type": "string"
        },
        "counterplay": {
          "type": "string"
        },
        "flavor": {
          "type": "string"
        },
        "illustration": {
          "type": "object",
          "required": [
            "path",
            "status",
            "brief"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "status": {
              "enum": [
                "pending",
                "generated reference illustration",
                "generated illustration"
              ]
            },
            "brief": {
              "type": "string"
            }
          }
        },
        "balance": {
          "type": "object",
          "required": [
            "version",
            "revision",
            "status",
            "role"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "type": "string"
            },
            "role": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
